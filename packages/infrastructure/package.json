{
  "name": "@career-companion/infrastructure",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@career-companion/kernel": "workspace:*",
    "@career-companion/portfolio-workspace": "workspace:*",
    "@career-companion/portfolio-workspace-application": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test:integration:portfolio-workspace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/portfolio-workspace-postgres-integration-runner.ts",
    "test:integration:portfolio-workspace-idempotency": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/portfolio-workspace-idempotency-integration-runner.ts",
    "test:integration:portfolio-workspace-runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/portfolio-workspace-runtime-integration-runner.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10"
  }
}
