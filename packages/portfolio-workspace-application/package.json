{
  "name": "@career-companion/portfolio-workspace-application",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./testing/index.ts",
      "default": "./testing/index.ts"
    }
  },
  "dependencies": {
    "@career-companion/kernel": "workspace:*",
    "@career-companion/portfolio-workspace": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"process.exit(0)\""
  }
}
