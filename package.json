{
  "name": "saurabh-product-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:root && pnpm run build:workspaces",
    "build:root": "next build",
    "build:workspaces": "turbo run build --filter=./apps/* --filter=./packages/*",
    "start": "next start",
    "lint": "pnpm run lint:root && pnpm run lint:workspaces",
    "lint:root": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workspaces": "turbo run lint --force --filter=./apps/* --filter=./packages/*",
    "typecheck": "pnpm run typecheck:root && pnpm run typecheck:workspaces",
    "typecheck:root": "tsc --noEmit",
    "typecheck:workspaces": "turbo run typecheck --filter=./apps/* --filter=./packages/*",
    "test": "pnpm run test:root && pnpm run test:workspaces",
    "test:root": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:workspaces": "turbo run test --filter=./apps/* --filter=./packages/*",
    "format": "prettier --write --ignore-unknown package.json pnpm-workspace.yaml turbo.json tsconfig.json tsconfig.base.json eslint.config.js prettier.config.js vitest.config.ts .editorconfig .npmrc .nvmrc .prettierignore",
    "format:check": "prettier --check --ignore-unknown package.json pnpm-workspace.yaml turbo.json tsconfig.json tsconfig.base.json eslint.config.js prettier.config.js vitest.config.ts .editorconfig .npmrc .nvmrc .prettierignore",
    "clean": "turbo run clean --filter=./apps/* --filter=./packages/*",
    "resume-os:validate-jd": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/resume-os/validate-jd-intelligence.ts",
    "resume-os:assemble": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/resume-os/assemble-resume.ts",
    "resume-os:validate-assembly": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/resume-os/validate-assembly.ts",
    "validate-narrative": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/resume-os/validate-narrative.ts",
    "validate-export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/resume-os/export-resume.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/resume-os/validate-export.ts",
    "career-os:intake": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/career-os/intake.ts",
    "career-os:resume-strategy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/career-os/resume-strategy.ts",
    "application-intelligence:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-intelligence/generate-application-intelligence.ts",
    "application-registry:init": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/init-registry.ts",
    "application-registry:create": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/create-application.ts",
    "application-registry:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/update-application.ts",
    "application-registry:transition": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/transition-application.ts",
    "application-registry:link-resume": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/link-resume.ts",
    "application-registry:create-contact": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/create-contact.ts",
    "application-registry:update-contact": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/update-contact.ts",
    "application-registry:link-contact": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/link-contact.ts",
    "application-registry:create-task": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/create-task.ts",
    "application-registry:complete-task": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/complete-task.ts",
    "application-registry:list-tasks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/list-tasks.ts",
    "application-registry:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/list-applications.ts",
    "application-registry:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/search-applications.ts",
    "application-registry:show": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/show-application.ts",
    "application-registry:daily": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/daily-view.ts",
    "application-registry:stale": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/find-stale.ts",
    "application-registry:archive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/archive-application.ts",
    "application-registry:rebuild-indexes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/rebuild-indexes.ts",
    "application-registry:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/validate-registry.ts",
    "application-registry:validate-privacy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/application-registry/validate-privacy.ts",
    "career-console:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/career-console/validate-career-console.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.2.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.15",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "turbo": "2.6.1",
    "vitest": "4.0.15",
    "typescript": "6.0.3"
  }
}
